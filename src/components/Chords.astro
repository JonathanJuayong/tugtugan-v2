---
import Controls from "./Controls.astro";
import {
    UltimateGuitarParser,
    ChordSheetSerializer
} from "chordsheetjs";

interface Props {
    chords: string
}

const {chords} = Astro.props

const parser = new UltimateGuitarParser()
const song = parser.parse(chords)
const serializer = new ChordSheetSerializer()
const serialized = serializer.serialize(song)
const stringSerial = JSON.stringify(serialized)
---
<Controls/>
<div data-song={stringSerial} class="songsheet">
</div>

<script>
    import {ChordLyricsPair, ChordSheetSerializer, type SerializedSong} from "chordsheetjs";
    import {subscribeToSong, setSong, getSong} from "../store.ts";

    const container = document.querySelector(".songsheet") as HTMLDivElement;
    const song = container.getAttribute("data-song")!
    const serialized = JSON.parse(song) as SerializedSong

    const serializer = new ChordSheetSerializer()
    const deserializedSong = serializer.deserialize(serialized)
    setSong(deserializedSong)

    subscribeToSong((newValue, _) => {
        let lineId = 0
        const chordLyricLines = newValue?.bodyLines.map((line) => {
            const lines = line.items.map((item, itemNumber) => {
                if (!item.parentLine) return

                if (item instanceof ChordLyricsPair) {
                    const span = (content: string | null) => `<span>${content}</span>`
                    const chords = span(item.chords)
                    const lyrics = span(item.lyrics)

                    // ensure alignment of chords and lyrics in case either are absent
                    if (item.chords.trim() === "") {
                        return `<div id="${lineId + 1}-${itemNumber + 1}" class="chord-lyric-pair group grid content-end whitespace-nowrap">${lyrics}</div>`
                    }

                    if (!item.lyrics) {
                        return `<div id="${lineId + 1}-${itemNumber + 1}" data-chord="${item.chords}" class="chord-lyric-pair group grid content-start whitespace-nowrap">${chords}</div>`
                    }

                    return `<div id="${lineId + 1}-${itemNumber + 1}" data-chord="${item.chords}" class="chord-lyric-pair group grid whitespace-nowrap">${chords}${lyrics}</div>`
                }
            }).filter(Boolean)

            if (lines.length > 0) {
                const preTag = `
                <pre id="${lineId + 1}" class="flex flex-wrap justify-items-start align-text-bottom gap-1 text-xs">
                    ${lines.join("")}
                </pre>
                `
                lineId++
                return preTag
            }
        }).join("")
        container.innerHTML = chordLyricLines!.toString()
    })
</script>