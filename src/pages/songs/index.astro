---
import {getCollection} from "astro:content";
import Body from "../../layouts/Body.astro";
import SongsList from "../../components/svelte/SongsList.svelte";

const songsCollection = await getCollection('songs')
const songs = songsCollection.map((song) => ({
    id: song.id,
    title: song.data.title,
    artist: song.data.artist
}))
---

<Body title="Songs">
    <main class="container narrow grid gap-4 pb-10">
        <SongsList client:load songs={songs} />
    </main>
</Body>
