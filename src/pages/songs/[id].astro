---
import {getCollection} from "astro:content";
import {getChords, getRandomSongs, getUrlFromIframe, getYoutubeEmbed} from "../../utils/songs.ts";
import YoutubeEmbed from "../../components/YoutubeEmbed.astro";
import SuggestedSongs from "../../components/SuggestedSongs.astro";
import Body from "../../layouts/Body.astro";
import ChordSheet from '../../components/svelte/ChordSheet.svelte'

export async function getStaticPaths() {
    const songs = await getCollection('songs');
    return songs.map((song) => ({
        params: {id: song.id},
        props: {song, songs}
    }))
}

const {song, songs} = Astro.props

const {body} = song
const youtubeIframe = getYoutubeEmbed(body!)!
const youtubeUrl = getUrlFromIframe(youtubeIframe)!
const chords = getChords(body!)!

const numberOfRandomSongs = 6;
const randomSongs = getRandomSongs(numberOfRandomSongs, songs)
const otherSongs = randomSongs.map(({id, data: {title, artist,}}) => ({
    id,
    title,
    artist,
}))
---
<Body title={song.data.title}>
<main class="container narrow space-y-6 relative">
    <section class="video">
        <YoutubeEmbed url={youtubeUrl}/>
        <h2 class="preset-typo-headline">{song.data.title}</h2>
        <p class="preset-typo-subtitle">{song.data.artist}</p>
        <div class="flex gap-2 mt-4">
            {song.data.tags.map((tag) => (<p class="chip preset-outlined">{tag}</p>))}
        </div>
    </section>
    <div class="mb-40">
        <ChordSheet client:load {chords}/>
    </div>
    <aside class="suggested min-h-screen pt-6">
        <SuggestedSongs songs={otherSongs}/>
    </aside>
</main>
</Body>
