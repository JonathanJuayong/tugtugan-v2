---
import '../styles/global.css'
import {Heart, PlayIcon} from '@lucide/astro'

interface Props {
    title: string
}

const {title} = Astro.props
---

<html data-theme="vintage" lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{title}</title>
</head>
<body class="bg-linear-to-br from-surface-700  to-surface-900 min-h-screen">
<header class="border-b border-surface-600 py-4 mb-4">
    <nav aria-label="main navigation" class="container narrow">
        <ul class="flex flex-wrap">
            <li class="font-extrabold">
                <a href="/">Tugtugan</a>
            </li>
            <li class="ml-auto font-light">
                <a class="btn btn-xs preset-filled-brand" href="/songs">
                    View Songs
                    <PlayIcon />
                </a>
            </li>
        </ul>
    </nav>
</header>
<slot/>
<footer class="border-t border-surface-600 py-6">
    <div class="container narrow flex gap-1 items-center text-surface-300">
        <p class="text-xs">Created by Jonathan Juayong with</p>
        <Heart class="inline" size={14}/>
    </div>
</footer>
</body>
</html>
