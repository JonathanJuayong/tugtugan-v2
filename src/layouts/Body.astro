---
import '../styles/global.css'
import {Heart, PlayIcon, ChevronRightIcon} from '@lucide/astro'
import {getCollection} from "astro:content";

interface Props {
    title: string
}

const {title} = Astro.props
const {pathname} = Astro.url
const pathnameSegments = pathname.split("/").filter(Boolean)

const pageIsViewSongs = pathnameSegments[0] === "songs"
const pageIsChords = pathnameSegments[1]?.includes("-")

const songs = await getCollection('songs')

const songTitle = songs.find(song => song.id === pathnameSegments[1])?.data.title
---

<html data-theme="vintage" lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{title}</title>
</head>
<body class="bg-linear-to-br dark:from-surface-700  dark:to-surface-900 min-h-screen">
<header class="border-b border-surface-600 py-4 mb-4">
    <nav aria-label="main navigation" class="container narrow">
        <ul class="flex flex-wrap">
            <li class="font-extrabold">
                <a href="/">Tugtugan</a>
            </li>
            <li class="ml-auto font-light">
                <a class="btn btn-xs preset-filled-brand" href="/songs">
                    View Songs
                    <PlayIcon/>
                </a>
            </li>
        </ul>
    </nav>
</header>
<div class="container narrow pb-4">
    {pageIsViewSongs && (
            <ul class="flex gap-4 items-center-safe uppercase font-extralight text-xs">
                <li><a class="anchor text-brand-contrast-light dark:text-brand-dark" href="/">Home</a></li>
                <li>
                    <ChevronRightIcon size="10"/>
                </li>
                {pathnameSegments.length > 1 ?
                        <li><a class="anchor text-brand-contrast-light dark:text-brand-dark" href="/songs">Songs</a></li> :
                        <li><p>Songs</p></li>}
                {(pageIsChords && pageIsViewSongs) &&
                        <li>
                            <ChevronRightIcon size="10"/>
                        </li>}
                {(pageIsChords && pageIsViewSongs) &&
                        <li><p class="font-bold">{songTitle}</p></li>}
            </ul>
    )}
</div>

<slot/>
<footer class="border-t border-surface-600 py-6">
    <div class="container narrow flex gap-1 items-center text-surface-300">
        <p class="text-xs">Created by Jonathan Juayong with</p>
        <Heart class="inline" size={14}/>
    </div>
</footer>
</body>
</html>
